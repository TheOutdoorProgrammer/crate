#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
export PATH="$HOME/go/bin:$PATH"
FAILED=0

run_check() {
    local name="$1"
    shift
    printf "\033[1;34m▶ %s\033[0m\n" "$name"
    if "$@"; then
        printf "\033[1;32m✓ %s passed\033[0m\n\n" "$name"
    else
        printf "\033[1;31m✗ %s failed\033[0m\n\n" "$name"
        FAILED=1
    fi
}

# --- Lint ---
mkdir -p "$ROOT/cmd/crate/dist" && touch "$ROOT/cmd/crate/dist/.keep"
run_check "golangci-lint" golangci-lint run --timeout 5m
run_check "eslint" bash -c "cd '$ROOT/web' && npx eslint src/"

# --- Security ---
GOSEC_EXCLUDES="G103,G104,G109,G115,G204,G301,G304,G401,G501"
run_check "gosec" gosec -exclude="$GOSEC_EXCLUDES" -quiet "$ROOT/..."
run_check "npm audit" bash -c "cd '$ROOT/web' && npm audit --audit-level=high"

# --- Build ---
run_check "tsc" bash -c "cd '$ROOT/web' && npx tsc -b"
run_check "go test" go test "$ROOT/..."

if [ "$FAILED" -ne 0 ]; then
    printf "\033[1;31mPre-commit checks failed. Commit aborted.\033[0m\n"
    exit 1
fi
printf "\033[1;32mAll pre-commit checks passed.\033[0m\n"
